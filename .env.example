# ================================================================
# PLANTILLA DE VARIABLES D'ENTORN — viscalaterra.cat
# Copia aquest fitxer com a .env i omple els valors reals.
# MAI afegeixis .env al repositori.
# ================================================================

# --- Base de dades ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=viscalaterra
DB_USER=
DB_PASSWORD=

# --- Backend ---
# En producció: NODE_ENV=production (evita que Express filtri stack traces).
NODE_ENV=development
PORT=3000

# Orígens permesos per CORS (separats per comes). En producció, posa-hi
# el domini real, p. ex. https://www.viscalaterra.cat
# Els usa també l'anti-CSRF: un navegador que no envia Sec-Fetch-Site només pot
# fer POST des d'aquests orígens o des del mateix host al qual parla.
CORS_ORIGINS=http://localhost:5173

# Límit de peticions per IP i finestra (rate limiting)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Autenticació JWT ---
# El token viatja en una cookie HttpOnly (backend/src/auth/sessio.ts) que caduca
# alhora que ell.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cookie de sessió només per HTTPS (Secure). Per defecte: sí amb NODE_ENV=production,
# no en dev. Posa COOKIE_SECURE=false NOMÉS per provar el stack de producció per
# HTTP des d'una IP de la LAN (per localhost no cal).
# COOKIE_SECURE=

# Rate limiting específic dels endpoints d'auth (anti-força bruta). Opcional.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# --- Login amb Google (OAuth) ---
# Client ID creat a Google Cloud Console (és públic, no és cap secret).
# El MATEIX valor serveix al backend (verifica el token de Google) i al botó
# "Continua amb Google" del frontend:
#   - Producció/staging: docker-compose.prod.yml el passa ell sol al frontend
#     (build arg VITE_GOOGLE_CLIENT_ID); només cal posar-lo aquí.
#   - Desenvolupament: a més, a frontend/.env.local com a VITE_GOOGLE_CLIENT_ID=...
# L'origen de cada entorn (p. ex. https://staging.viscalaterra.cat) s'ha
# d'autoritzar al client OAuth de Google Cloud Console.
# Si es deixa buit, l'auth per email/contrasenya funciona igual i el botó de
# Google no apareix.
GOOGLE_CLIENT_ID=

# --- Frontend ---
# Nota: el codi del frontend fa servir rutes relatives (/api/...). Aquesta variable
# només l'usa el proxy de Vite en desenvolupament; en producció no cal.
VITE_API_URL=http://localhost:3000

# ================================================================
# PRODUCCIÓ (docker-compose.prod.yml)
# ================================================================
# Adreça que serveix Caddy. Controla també el TLS:
#   - En LOCAL (simulació): deixa-ho sense definir → Caddy escolta a :80 (HTTP).
#   - Al VPS: posa el domini real → Caddy treu i renova el certificat HTTPS sol.
#       SITE_ADDRESS=viscalaterra.cat
# SITE_ADDRESS=
#
# Ports del host que mapeja Caddy. Per defecte 80/443 (VPS). En LOCAL amb Docker
# rootless cal usar ports >= 1024 per simular:
#   HTTP_PORT=8080
#   HTTPS_PORT=8443
#
# Entorn de Caddy (frontend/Caddyfile). Sense definir → producció: ni porta ni
# cartell. Al servidor de STAGING, porta amb una contrasenya compartida i
# cartell «no m'indexis» per als cercadors:
#   CADDY_ENTORN=staging
#   STAGING_HASH='<hash de «caddy hash-password»>'   ← entre cometes SIMPLES:
#                                                     el hash porta signes $
# L'usuari de la porta és fix: viscalaterra. Mai la contrasenya en clar: només el
# hash. Si CADDY_ENTORN=staging però falta el hash, Caddy no arrenca (millor no
# obrir que obrir sense porta).
#
# Recordatori de valors per a producció:
#   DB_HOST=db                         (nom del servei Docker, no 'localhost')
#   NODE_ENV=production
#   CORS_ORIGINS=https://viscalaterra.cat
#   JWT_SECRET=<secret llarg i aleatori>
#   DB_PASSWORD=<contrasenya forta>
